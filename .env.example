# ============================================================
# Crimson Sentinel — configuração de ambiente
# Copie para .env e preencha os valores necessários.
# ============================================================

# ---- IA (extração/análise via worker assíncrono) ----
GEMINI_API_KEY=
# Opcionais para busca avançada de comparação:
SERPER_API_KEY=
TAVILY_API_KEY=
# Opcional: Popular Times (FASE 7) — best-effort; fallback heurístico se ausente
SERPAPI_KEY=

# ---- Notificações ----
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_USER=
GMAIL_PASS=

# ---- Infra de fila (A5) ----
# Default: redis://127.0.0.1:6379 — sobe via `docker compose up -d`
REDIS_URL=redis://127.0.0.1:6379
# Alternativas (não obrigatórias se REDIS_URL estiver definido):
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ---- Scanner ----
# Timeout por job de scraping (ms). Default 590000 (9min 50s).
SCAN_TIMEOUT_MS=590000

# ---- Monitoramento Social (FASE 9/10) ----
# Ligar/desligar o módulo social inteiro (worker ignora jobs se false).
# Esta flag é lida por NÃO-inicializar o worker social nem os workers filhos;
# o equivalente em SQLite (user_settings.social_monitoring_enabled) também pode
# ser ajustado em runtime via UI.
SOCIAL_MONITORING_ENABLED=false

# WhatsApp (FASE 9) — whatsapp-web.js. Usar SEMPRE conta secundária dedicada.
# (Aviso: API não-oficial, viola ToS do WhatsApp; risco de ban da conta.)
WHATSAPP_ENABLED=false

# Instagram (FASE 10) — instagrapi via microserviço Python local.
# (Aviso: API não-oficial, viola ToS do Instagram; usar conta secundária.)
INSTAGRAM_ENABLED=false
# Porta do microserviço FastAPI (python_instagram/server.py)
INSTAGRAM_SERVICE_PORT=8721

# ---- Servidor ----
PORT=3000
NODE_ENV=development
